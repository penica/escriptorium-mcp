# eScriptorium site root (without /api/)
ESCRIPTORIUM_URL=http://127.0.0.1:8091/
ESCRIPTORIUM_API_KEY=
# Alternative authentication:
# ESCRIPTORIUM_USERNAME=
# ESCRIPTORIUM_PASSWORD=

# Required only for full-register downloads. Existing mounted Books directory.
# Use this machine's native absolute path. Single quotes preserve Windows backslashes.
# macOS: ESCRIPTORIUM_BOOKS_ROOT='/Volumes/home/Archive/Books'
# Linux: ESCRIPTORIUM_BOOKS_ROOT='/mnt/nas/Archive/Books'
# Windows: ESCRIPTORIUM_BOOKS_ROOT='Z:\Archive\Books'
# UNC: ESCRIPTORIUM_BOOKS_ROOT='\\nas\home\Archive\Books'

# Required only for Streamable HTTP. Generate a separate random token (32+ chars).
# ESCRIPTORIUM_HTTP_TOKEN=
# Optional writable worker cache root:
# ESCRIPTORIUM_WORKER_CACHE=
