# Reachable eScriptorium site root, WITHOUT /api/. Change for your WSL deployment.
ESCRIPTORIUM_URL=http://127.0.0.1:8091/
ESCRIPTORIUM_API_KEY=
# Full-register downloads only: existing NAS mount, never a local staging folder.
# ESCRIPTORIUM_BOOKS_ROOT=/mnt/nas/Archive/Books
# install.sh adds a randomly generated HTTP token below. Keep it private.
